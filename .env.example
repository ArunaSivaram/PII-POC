# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fast Gemini Flash model. As of Nov 2026, gemini-3.8-flash is the default
# recommended fast model (gemini-3.6-flash retires 2026-11-19).
GEMINI_MODEL=gemini-3.8-flash

# Disable Gradio's anonymous usage analytics
GRADIO_ANALYTICS_ENABLED=False

# Disable Hugging Face Hub telemetry pings during model downloads
HF_HUB_DISABLE_TELEMETRY=1
