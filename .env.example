# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fast Gemini Flash model. As of Nov 2026, gemini-3.8-flash is the default
# recommended fast model (gemini-3.6-flash retires 2026-11-19).
GEMINI_MODEL=gemini-3.8-flash

# Optional: override the model used for the Tab 3 chat only. Falls back
# to GEMINI_MODEL when unset.
GEMINI_CHAT_MODEL=

# Optional: cap the number of chat questions per browser session on
# Tab 3 (default 50).
CHAT_MAX_QUESTIONS=50

# Disable Gradio's anonymous usage analytics
GRADIO_ANALYTICS_ENABLED=False

# Disable Hugging Face Hub telemetry pings during model downloads
HF_HUB_DISABLE_TELEMETRY=1
